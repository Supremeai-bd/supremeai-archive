{
  "name": "supremeai-studio",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "build": "vite build",
    "clean": "rm -rf dist server.js",
    "dev": "tsx server.ts",
    "i18n:check": "node scripts/check-i18n.mjs",
    "i18n:update": "node scripts/check-i18n.mjs --update",
    "lint": "tsc --noEmit",
    "lint:eslint": "eslint .",
    "lint:all": "npm run lint && npm run lint:eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "http:check": "node scripts/check-http.mjs",
    "http:update": "node scripts/check-http.mjs --update",
    "any:check": "node scripts/check-any.mjs",
    "any:update": "node scripts/check-any.mjs --update",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:install": "playwright install chromium",
    "preview": "vite preview",
    "smoke": "node scripts/smoke-live.mjs",
    "start": "tsx server.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@google/genai": "^3.2.0",
    "@mediapipe/face_detection": "^0.4.1646425229",
    "@mediapipe/face_mesh": "^0.4.1633559619",
    "@tensorflow-models/face-detection": "^1.0.3",
    "@tensorflow-models/face-landmarks-detection": "^1.0.6",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "@tensorflow/tfjs-backend-webgl": "^4.22.0",
    "@tensorflow/tfjs-converter": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.4.0",
    "lucide-react": "^0.546.0",
    "marked": "^18.2.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "tesseract.js": "^7.0.0",
    "three": "^0.187.0",
    "ws": "^8.23.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.0",
    "vitest": "^5.1.0"
  },
  "description": "SupremeAI Studio — bilingual AI workspace console (React 19 + Vite, Cloudflare Pages).",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.1"
  }
}
